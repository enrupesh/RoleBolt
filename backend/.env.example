NODE_ENV=production
PORT=8080

# MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# AI gateway key — Mesh API (resume scoring, copilot, form scoring, JD fallback, etc.)
GOOGLEM_API_KEY=rsk_...

# Google Gemini API key (JD generation — direct Gemini API)
GOOGLE_API_KEY=

# Nvidia NIM API key (ultimate fallback for all AI features)
GOOGLEN_API_KEY=

# Comma-separated allowed origins — set to your deployed frontend URL(s)
CORS_ORIGIN=https://your-recruit-app.vercel.app

# SESSION_SECRET — used by custom auth (JWT signing, session cookies, etc.)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
