NODE_ENV=production
PORT=8080

# MongoDB connection string (can be the same database as the main Plyndrox app,
# or a fresh one if you want the standalone tool's data kept separate).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# NVIDIA AI API key (used for resume scoring / job description generation)
NVIDIA_API_KEY=nvapi-...

# Firebase Admin SDK — paste the full service account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}

# Comma-separated allowed origins — set to your deployed frontend URL(s)
CORS_ORIGIN=https://your-recruit-app.vercel.app
