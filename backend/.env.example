NODE_ENV=production
PORT=8080

# MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# AI gateway key — Mesh API (resume scoring, copilot, form scoring, JD fallback, etc.)
GOOGLEM_API_KEY=rsk_...

# Google Gemini API key (JD generation — direct Gemini API)
GOOGLE_API_KEY=

# Nvidia NIM API key (ultimate fallback for all AI features)
GOOGLEN_API_KEY=

# Firebase Admin SDK — paste the full service account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}

# Comma-separated allowed origins — set to your deployed frontend URL(s)
CORS_ORIGIN=https://your-recruit-app.vercel.app
