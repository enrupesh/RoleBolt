NODE_ENV=production
PORT=8080

# MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── Authentication ──────────────────────────────────────────────────────────
# JWT signing secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=

# Resend API key — for sending verification emails
RESEND_API_KEY=re_...

# Sender identity configuration (both addresses must be verified in Resend)
FROM_NAME=Rolebolt
# Authentication/security emails only: verification and password reset
AUTH_FROM_EMAIL=verify@rolebolt.tech
# All candidate, recruiter, team, briefing, alert, and offer emails
NOTIFICATION_FROM_EMAIL=notifications@rolebolt.tech
# Legacy auth fallback retained for older deployments; prefer AUTH_FROM_EMAIL.
SMTP_FROM_EMAIL=verify@rolebolt.tech

# Public URL of the frontend — used to build verification email links
FRONTEND_URL=https://www.rolebolt.tech

# ── AI keys ─────────────────────────────────────────────────────────────────
# Mesh API gateway key (Gemini models via Mesh) (resume scoring, copilot, form scoring, etc.)
GEMINI_MESH_KEY=rsk_...

# Google Gemini direct API key (JD generation)
GEMINI_PRIMARY_KEY=

# Google reCAPTCHA v3 secret key — verifies tokens from the frontend
# Register at: https://www.google.com/recaptcha (Score based v3, no billing)
RECAPTCHA_SECRET_KEY=

# Nvidia NIM fallback key (AI fallback)
GEMINI_FALLBACK_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins
CORS_ORIGIN=https://www.rolebolt.tech

# ── Razorpay billing (required for paid checkout) ────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# One plan ID per paid catalog entry (18 total). Run:
#   npm run billing:sync-razorpay-plans
# to create missing plans and print env var names.
RAZORPAY_PLAN_SEEKER_PRO_MONTHLY=
RAZORPAY_PLAN_SEEKER_PRO_YEARLY=
RAZORPAY_PLAN_SEEKER_ULTRA_MONTHLY=
RAZORPAY_PLAN_SEEKER_ULTRA_YEARLY=
RAZORPAY_PLAN_CREATOR_FORM_PRO_MONTHLY=
RAZORPAY_PLAN_CREATOR_FORM_PRO_YEARLY=
RAZORPAY_PLAN_CREATOR_FORM_ULTRA_MONTHLY=
RAZORPAY_PLAN_CREATOR_FORM_ULTRA_YEARLY=
RAZORPAY_PLAN_CREATOR_STANDARD_PRO_MONTHLY=
RAZORPAY_PLAN_CREATOR_STANDARD_PRO_YEARLY=
RAZORPAY_PLAN_CREATOR_STANDARD_ULTRA_MONTHLY=
RAZORPAY_PLAN_CREATOR_STANDARD_ULTRA_YEARLY=

# Internal admin panel password (verification review at /recruit/raka98/admin)
RAKA98_ADMIN_PASSWORD=

# Firebase Admin SDK — paste full service account JSON for Google/Microsoft SSO
FIREBASE_SERVICE_ACCOUNT_JSON=

# Premium creator candidate emails (Pro / Ultra Pro)
CREATOR_OUTBOUND_FROM_EMAIL=no-reply@jobcreators.rolebolt.tech
